# ─────────────────────────────────────────────────────────────
# STRIPE — TEST MODE (за development и преди live)
# Вземаш ги от: https://dashboard.stripe.com/test/apikeys
# ─────────────────────────────────────────────────────────────

# Server-side (Stripe Secret Key — НИКОГА не push-вай в git)
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret (от stripe listen ИЛИ от Dashboard → Webhooks → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Client-side (Publishable — безопасно за фронтенда)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Price IDs (от Stripe Dashboard → Products)
# Monthly €24.99/мес recurring
VITE_PRICE_MONTHLY=price_...
# Lifetime €69.99 one-time
VITE_PRICE_LIFETIME=price_...

# ─────────────────────────────────────────────────────────────
# SUPABASE — Auth + user progress persistence
# Settings → API → Project URL + publishable/anon key
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Server-side only. Needed for Stripe webhook/payment verification to grant course access.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
